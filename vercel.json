{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/fdw-extract.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/plaid-sync",
      "schedule": "0 6,14,15,21 * * *"
    },
    {
      "path": "/api/bank-morning?capture=1",
      "schedule": "10 14,15 * * *"
    },
    {
      "path": "/api/fdw-qbo-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/fdw-extract",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/fdw-samsara",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/ar-snapshot",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/daily-snapshot",
      "schedule": "15 10 * * *"
    }
  ]
}